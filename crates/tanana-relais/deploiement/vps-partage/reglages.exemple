# Copier en .env (jamais envoyé sur GitHub) puis remplir.

# Codes d'invitation donnés aux hôtels, au moins 8 caractères, séparés par des virgules.
# En créer un : openssl rand -hex 6
TANANA_RELAIS_CODES=

# Nombre maximal d'hôtels inscrits (un seul hôtel utilise Tanana : 1)
TANANA_RELAIS_HOTELS_MAX=1

# Réseau Docker du Caddy qui tient les ports 80/443
RESEAU_PROXY=kadran_internal
